# Copy this file to ".env" (same folder) and fill in the values.
# Never commit the real .env — it is already listed in .gitignore.
# Find these in Supabase → Project Settings → API Keys / Data API.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The public "anon" key (safe for sign-in requests)
SUPABASE_ANON_KEY=

# The secret "service_role" key — server only, keep it private
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public address of the site, used in email links.
# Leave empty to use the address the request came from.
SITE_URL=

# Optional: port for local development (default 3000)
PORT=
